{
  "compilerOptions": {
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "target": "es2023",
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node",
      "mocha"
    ],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
