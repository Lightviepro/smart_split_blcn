# Smart Split — Sepolia deployment settings (ONLY needed for `npm run deploy:sepolia`).
#
# The recommended way to deploy to Sepolia is Remix + MetaMask (see ../remix/REMIX_GUIDE.md),
# which needs none of these values.
#
# ── Option A (preferred): Hardhat's encrypted keystore ────────────────────────────────
#   npx hardhat keystore set SEPOLIA_RPC_URL
#   npx hardhat keystore set SEPOLIA_PRIVATE_KEY
#   npx hardhat keystore set ETHERSCAN_API_KEY      # optional, only for verification
# Values are stored encrypted with a password you choose, outside this project folder.
#
# ── Option B: a plain .env file ───────────────────────────────────────────────────────
#   cp .env.example .env     then fill in the values below. `.env` is git-ignored.
#
# ⚠️  SAFETY
#   - Use a DEDICATED THROWAWAY account that only holds a little Sepolia test ETH.
#     NEVER use the private key of your main MetaMask account.
#   - Never paste a private key or seed phrase into a chat, an issue, or a commit.
#   - This project never connects to Ethereum mainnet.

# RPC endpoint for Sepolia, e.g. from Alchemy / Infura, or a public one such as
# https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=

# 0x-prefixed private key of the throwaway deployer account (64 hex characters).
SEPOLIA_PRIVATE_KEY=

# Optional — only for `npm run verify:sepolia` (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=
