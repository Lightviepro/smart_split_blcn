{
  "name": "smart-split-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test mocha",
    "coverage": "hardhat test mocha --coverage",
    "gas": "hardhat test mocha --gas-stats",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "export-abi": "hardhat compile --quiet && node scripts/export-abi.ts",
    "demo:local": "hardhat run scripts/demo-local.ts --network localhost",
    "verify:sepolia": "hardhat verify --network sepolia",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.12",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.1",
    "@nomicfoundation/hardhat-mocha": "^4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.1.2",
    "@nomicfoundation/ignition-core": "^3.1.10",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^5.3.3",
    "ethers": "^6.17.0",
    "hardhat": "^3.19.0",
    "mocha": "^12.0.3",
    "typescript": "~5.8"
  }
}
